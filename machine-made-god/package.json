{
  "name": "machine-made-god",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "generate": "node --env-file-if-exists=.env scripts/generate.mjs",
    "test": "node --test tests/*.test.mjs lab/*/test/*.test.mjs",
    "machine:check": "node --env-file-if-exists=.env scripts/generate.mjs --check",
    "control": "astro build && node --env-file-if-exists=.env scripts/control-server.mjs",
    "promote": "node --env-file-if-exists=.env scripts/promote.mjs",
    "shorts": "node --env-file-if-exists=.env scripts/shorts.mjs",
    "replies": "node --env-file-if-exists=.env scripts/replies.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@noble/hashes": "2.4.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.5",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "libsodium-wrappers": "0.8.4"
  }
}
