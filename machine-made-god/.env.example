# Copy to .env for local runs (npm run generate). In production these are GitHub secrets.
# You only need ONE key to start; more keys = more chances the roulette lands on a working provider.
# All of these have free tiers. Limits change; check each provider's site.

GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys  (only ":free" models are used)
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
DASHSCOPE_API_KEY=      # Alibaba Cloud Model Studio (Qwen), international region: https://modelstudio.console.alibabacloud.com

# Optional: a local model on this computer via Ollama (https://ollama.com). Only for local runs.
# OLLAMA_ENABLED=1
# Optional: Ollama's cloud models (key from https://ollama.com/settings/keys). Works locally and on GitHub.
# OLLAMA_API_KEY=

# Optional PAID fallbacks, only used when every free provider fails. Leave empty to stay at $0.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=         # https://platform.openai.com/api-keys (needs prepaid credits)

# Optional: pause the machine without editing files.
# MACHINE_ENABLED=false

# Site settings (also settable in Netlify → Site configuration → Environment variables)
# SITE_URL=https://machinemadegod.netlify.app
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# PUBLIC_ADSENSE_SLOT_HOME=
# PUBLIC_ADSENSE_SLOT_LIST=
# PUBLIC_ADSENSE_SLOT_ARTICLE=
# PUBLIC_ADSENSE_SLOT_SIDE=
# PUBLIC_MERCH_STORE_URL=
