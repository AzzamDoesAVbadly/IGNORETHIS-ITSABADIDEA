---
import Base from "../layouts/Base.astro";
import FakeAd from "./FakeAd.astro";
interface Props { title: string; description: string; how: string }
const { title, description, how } = Astro.props;
---
<Base title={`${title} — Arcade`} description={description}>
  <section class="arcade-band" style="border-top:0">
    <div class="wrap">
      <a class="mono" href="/arcade/" style="color:#ffd400;text-decoration:none">← The Arcade</a>
      <h1 class="display" style="color:#ff6a13;font-size:clamp(2.4rem,7vw,4.4rem);margin:10px 0 6px">{title}</h1>
      <p style="color:#c9bfa8;max-width:680px;margin:0 0 22px">{description}</p>
      <div class="game-stage"><slot /></div>
      <p class="mono" style="color:#8c8576;margin-top:14px">How to play: {how}</p>
    </div>
  </section>
  <div class="wrap section"><FakeAd seed={title} wide /></div>
</Base>

<style is:global>
  .game-stage {
    background: #0d0a08;
    border: 3px solid var(--sodium);
    box-shadow: 6px 6px 0 #000;
    color: var(--paper);
    padding: clamp(14px, 3vw, 24px);
  }
  .game-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .game-stat { background: #1f1814; border: 2px solid #3a2e25; padding: 8px 12px; min-width: 120px; }
  .game-stat b { display: block; font-family: var(--font-display); font-stretch: 78%; font-weight: 900; font-size: 1.6rem; color: var(--hazard); line-height: 1; }
  .game-stat span { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: #a89e88; }
  .game-log { font-family: var(--font-mono); font-size: 0.78rem; color: var(--acid); min-height: 1.4em; margin: 12px 0 0; }
</style>
