---
import Base from "../layouts/Base.astro";
import { adsenseClient } from "../lib/site.js";
---
<Base title="Privacy Policy" description="What this site collects (very little) and what ad partners may collect.">
  <div class="wrap">
    <header class="page-head">
      <span class="label">Privacy</span>
      <h1>Privacy Policy</h1>
      <p>Plain English. Last updated {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long" })}.</p>
    </header>
    <div class="prose" style="max-width:720px">
      <h2>What we collect</h2>
      <p>This site has no accounts, no comments, and no sign-up forms. We don't ask for your name or email. Poll votes and game progress are saved only in your own browser (local storage) and never sent to us.</p>
      <h2>Advertising</h2>
      <p>{adsenseClient ? "This site shows ads from Google AdSense." : "This site may show ads from Google AdSense."} Google and its partners use cookies to show ads based on your visits to this and other websites. You can opt out of personalized advertising at <a href="https://adssettings.google.com" rel="noopener">Google Ads Settings</a>, and learn more at <a href="https://policies.google.com/technologies/ads" rel="noopener">How Google uses information from sites that use its services</a>.</p>
      <h2>Hosting</h2>
      <p>The site is hosted on Netlify, which may keep standard server logs (such as IP address and browser type) for security and performance.</p>
      <h2>Fonts</h2>
      <p>Fonts load from Google Fonts, which receives your IP address when the page loads.</p>
      <h2>Children</h2>
      <p>This site is not directed at children under 13.</p>
      <h2>Changes</h2>
      <p>If this policy changes, the date at the top will change too.</p>
    </div>
  </div>
</Base>
