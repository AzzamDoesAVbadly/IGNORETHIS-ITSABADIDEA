---
import Base from "../../layouts/Base.astro";
import FakeAd from "../../components/FakeAd.astro";
import { company, generate, logoSvg } from "../../../lab/synergy-ipsum/src/index.js";
import lab from "../../data/lab.json";

const product = lab.find((p) => p.slug === "synergy-engine")!;
// Rendered at build time so the page works before (and without) JavaScript.
const co = company({ seed: "launch" });
const initial = generate("memo", { seed: "launch-0", company: co });

const types = [
  { id: "memo", label: "Layoff memo", counted: "Paragraphs", count: 3 },
  { id: "paragraphs", label: "Corporate ipsum", counted: "Paragraphs", count: 3 },
  { id: "headlines", label: "Press headlines", counted: "Headlines", count: 5 },
  { id: "terms", label: "Terms update", counted: "Changes", count: 3 },
  { id: "cookie", label: "Cookie banner" },
  { id: "mission", label: "Mission statement" },
  { id: "slogan", label: "Slogans", counted: "Slogans", count: 5 },
];
const pct = (n: number) => `${n > 0 ? "▲" : "▼"} ${Math.abs(n).toFixed(2)}%`;
---
<Base title="SYNERGY ENGINE: Lorem Ipsum for the End Times" description="Free placeholder text made of layoff memos, mission statements, cookie banners and Terms updates, plus a fake megacorp generator with logos. Open-source npm package and CLI.">
  <section class="lab-band se" style="margin-top:0;border-top:0">
    <div class="wrap">
      <a class="mono" href="/lab/" style="color:var(--teal-hi);text-decoration:none">← MMG Labs</a>
      <header class="se-hero">
        <span class="label" style="--c:var(--hazard)">{product.code} · Free · Open source</span>
        <h1 class="display">Synergy<br />Engine</h1>
        <p>Lorem ipsum for the end times. Placeholder text made of what companies actually say: layoff memos, mission statements, cookie banners, “we've updated our Terms.” Plus a generator for an entire fake megacorp, logo included. Every company is fictional. Every sentence is something a real company has basically said.</p>
      </header>

      <div class="se-grid">
        <article class="se-co" aria-labelledby="se-co-name" data-co>
          <div class="se-co-bar mono"><span>Company registry</span><span data-co-seed>#{co.seed}</span></div>
          <div class="se-logo" data-logo set:html={logoSvg(co)} />
          <div class="se-co-body">
            <h2 id="se-co-name" data-co-name>{co.name}</h2>
            <p class="se-ticker mono"><b data-co-ticker>{co.ticker}</b> <span data-co-price>${co.stock.price.toFixed(2)}</span> <span class:list={["se-chg", co.stock.change < 0 && "down"]} data-co-change>{pct(co.stock.change)}</span></p>
            <p class="se-slogan" data-co-slogan>“{co.slogan}”</p>
            <dl class="se-facts">
              <div><dt>Industry</dt><dd data-co-industry>{co.industry}</dd></div>
              <div><dt>HQ</dt><dd data-co-hq>{co.hq}</dd></div>
              <div><dt>Founded</dt><dd data-co-founded>{co.founded}</dd></div>
              <div><dt>CEO</dt><dd data-co-ceo>{co.ceo}, {co.ceoTitle}</dd></div>
              <div><dt>Workforce</dt><dd data-co-staff>{co.employees.toLocaleString("en-US")} humans, {co.agents.toLocaleString("en-US")} agents</dd></div>
            </dl>
            <p class="se-mission" data-co-mission>{co.mission}</p>
          </div>
          <div class="se-co-actions">
            <button type="button" class="btn" data-new-co>Found another company</button>
            <button type="button" class="btn btn--ghost" data-share>Copy link</button>
            <button type="button" class="btn btn--ghost" data-logo-dl>Logo .svg</button>
          </div>
        </article>

        <section class="se-disp" aria-labelledby="se-disp-h">
          <div class="se-disp-head">
            <h2 id="se-disp-h" class="display">Ipsum dispenser</h2>
            <span class="mono">on behalf of <b data-co-short>{co.shortName}</b></span>
          </div>
          <div class="se-types" role="radiogroup" aria-label="Document type">
            {types.map((t, i) => (
              <button type="button" class="lab-chip se-type" role="radio" aria-checked={i === 0 ? "true" : "false"} data-type={t.id} data-counted={t.counted || ""} data-count={t.count || ""}>{t.label}</button>
            ))}
          </div>
          <div class="se-controls">
            <label class="mono" data-count-wrap><span data-count-label>Paragraphs</span>
              <select data-count>{[1, 2, 3, 4, 5, 6, 8, 10].map((n) => <option value={n} selected={n === 3}>{n}</option>)}</select>
            </label>
            <button type="button" class="btn btn--dark" data-regen>Regenerate</button>
            <button type="button" class="btn" data-copy-out>Copy text</button>
          </div>
          <div class="se-out" data-out aria-live="polite">{initial}</div>
          <a class="se-verified" href="/lab/humanity-check/" data-verified>
            <span class="mono">Verified by HUMANITY CHECK™</span>
            <b data-slop>—</b>
          </a>
        </section>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="se-install-h">
      <div class="section-head">
        <h2 id="se-install-h">Take it home<span class="scrawl">your mockups deserve better than latin</span></h2>
        <a class="more" href={product.repo}>Source on GitHub →</a>
      </div>
      <div class="grid lab-install se-install">
        <div class="lab-box">
          <span class="label" style="--c:var(--hazard)">Terminal</span>
          <h3>Fill anything</h3>
          <pre><code>{`npx synergy-ipsum -n 2
npx synergy-ipsum memo
npx synergy-ipsum logo > logo.svg`}</code></pre>
          <p>Paragraphs, memos, headlines, cookie banners, Terms updates, slogans and whole companies. Add <code>--seed</code> for the same output every time.</p>
          <button type="button" class="btn btn--ghost" data-copy-text="npx synergy-ipsum -n 2">Copy command</button>
        </div>
        <div class="lab-box">
          <span class="label" style="--c:var(--acid)">Library</span>
          <h3>Seed your app</h3>
          <pre><code>{`import { ipsum, company, generate }
  from "synergy-ipsum";

const co = company({ seed: "acme" });
generate("memo", { company: co });`}</code></pre>
          <p>Deterministic, so your snapshot tests stay green while your fake CEO lays off fake people in exactly the same words every run.</p>
          <a class="btn btn--ghost" href={product.repo}>View the code</a>
        </div>
        <div class="lab-box">
          <span class="label" style="--c:var(--magenta)">Why</span>
          <h3>Lorem ipsum lies</h3>
          <p>Latin placeholder text makes every design look calm. Real product copy is a cookie banner, a 40-word error message and a CEO's apology. Design for the text you'll actually get.</p>
          <p>Zero dependencies. MIT licensed. Every company is fictional; if one matches a real company, that's a coincidence and also a sign.</p>
        </div>
      </div>
    </section>
    <section class="section"><FakeAd seed="synergy-engine" wide /></section>
  </div>
</Base>

<style>
  .se-hero { margin: 14px 0 26px; }
  .se-hero h1 { color: var(--hazard); font-size: clamp(3.4rem, 11vw, 7.5rem); margin: 12px 0 10px; line-height: 0.82; }
  .se-hero p { max-width: 720px; margin: 0; color: #c6d0c4; font-size: 1.12rem; line-height: 1.5; }

  .se-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 22px; align-items: start; }
  .se-co { background: var(--paper-hi); color: var(--ink); border: 3px solid var(--hazard); box-shadow: 6px 6px 0 #000; position: sticky; top: 16px; }
  .se-co-bar { display: flex; justify-content: space-between; padding: 8px 14px; background: var(--ink); color: var(--hazard); }
  .se-logo { border-bottom: 2px solid var(--ink); line-height: 0; }
  .se-logo :global(svg) { display: block; width: 100%; height: auto; }
  .se-co-body { padding: 16px 18px 6px; }
  .se-co-body h2 { margin: 0; font: 900 clamp(1.8rem, 3.4vw, 2.5rem)/0.95 var(--font-display); font-stretch: 75%; text-transform: uppercase; }
  .se-ticker { margin: 8px 0 0; color: var(--ink-2); font-size: 0.8rem; }
  .se-ticker b { background: var(--ink); color: var(--paper); padding: 1px 6px; }
  .se-chg { color: #1d7a3a; font-weight: 600; }
  .se-chg.down { color: #c0222f; }
  .se-slogan { margin: 12px 0 0; font: 800 1.15rem/1.3 var(--font-body); font-style: italic; }
  .se-facts { margin: 14px 0 0; display: grid; gap: 6px; }
  .se-facts div { display: grid; grid-template-columns: 92px 1fr; gap: 8px; border-top: 1px dashed var(--ink-3); padding-top: 6px; }
  .se-facts dt { font: 600 0.66rem/1.6 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .se-facts dd { margin: 0; font-size: 0.93rem; }
  .se-mission { margin: 14px 0 0; padding: 10px 12px; background: var(--paper); border-left: 5px solid var(--hazard); font-size: 0.95rem; line-height: 1.45; }
  .se-co-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 18px 18px; }
  .se-co-actions .btn { font-size: 0.85rem; padding: 10px 12px; }

  .se-disp { background: #101b19; border: 3px solid var(--teal-hi); box-shadow: 6px 6px 0 #000; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .se-disp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .se-disp-head h2 { margin: 0; color: var(--acid); font-size: clamp(1.8rem, 3.4vw, 2.4rem); }
  .se-disp-head .mono { color: #8fa39b; }
  .se-disp-head b { color: var(--hazard); }
  .se-types { display: flex; flex-wrap: wrap; gap: 8px; }
  .se-type[aria-checked="true"] { background: var(--hazard); }
  .se-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .se-controls label { display: flex; align-items: center; gap: 8px; color: #a9b6af; margin-right: auto; }
  .se-controls select { font: 600 0.95rem var(--font-body); padding: 8px 10px; background: var(--paper-hi); color: var(--ink); border: 2px solid var(--ink); }
  .se-controls .btn { font-size: 0.85rem; padding: 10px 14px; }
  .se-out {
    background: var(--paper-hi); color: var(--ink); border: 3px solid var(--ink); padding: 18px 20px; min-height: 320px; max-height: 620px; overflow-y: auto;
    white-space: pre-wrap; overflow-wrap: anywhere; font-size: 1rem; line-height: 1.6;
  }
  .se-verified { display: flex; justify-content: space-between; align-items: center; gap: 12px; text-decoration: none; background: #172623; border: 2px solid #24403b; padding: 10px 14px; color: #a9b6af; }
  .se-verified:hover { border-color: var(--magenta); }
  .se-verified b { font: 900 1.15rem/1 var(--font-display); font-stretch: 80%; text-transform: uppercase; color: var(--magenta); }

  .se-install .lab-box { min-width: 0; }

  @media (max-width: 900px) {
    .se-grid { grid-template-columns: minmax(0, 1fr); }
    .se-co { position: static; }
  }
</style>

<script>
  import { company, generate, logoSvg, randomSeed } from "../../../lab/synergy-ipsum/src/index.js";
  import { analyze } from "../../../lab/humanity-check/src/index.js";

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const set = (s: string, v: string) => ($(s).textContent = v);
  const out = $("[data-out]");
  const countSel = $<HTMLSelectElement>("[data-count]");
  const types = [...document.querySelectorAll<HTMLButtonElement>("[data-type]")];

  let seed = new URLSearchParams(location.search).get("co")?.slice(0, 40) || randomSeed();
  let co = company({ seed });
  let type = "memo";
  let run = 0;

  function renderCompany() {
    $("[data-logo]").innerHTML = logoSvg(co);
    set("[data-co-seed]", `#${co.seed}`);
    set("[data-co-name]", co.name);
    set("[data-co-short]", co.shortName);
    set("[data-co-ticker]", co.ticker);
    set("[data-co-price]", `$${co.stock.price.toFixed(2)}`);
    const chg = $("[data-co-change]");
    chg.textContent = `${co.stock.change > 0 ? "▲" : "▼"} ${Math.abs(co.stock.change).toFixed(2)}%`;
    chg.classList.toggle("down", co.stock.change < 0);
    set("[data-co-slogan]", `“${co.slogan}”`);
    set("[data-co-industry]", co.industry);
    set("[data-co-hq]", co.hq);
    set("[data-co-founded]", String(co.founded));
    set("[data-co-ceo]", `${co.ceo}, ${co.ceoTitle}`);
    set("[data-co-staff]", `${co.employees.toLocaleString("en-US")} humans, ${co.agents.toLocaleString("en-US")} agents`);
    set("[data-co-mission]", co.mission);
  }

  function renderText() {
    const btn = types.find((b) => b.dataset.type === type)!;
    const counted = btn.dataset.counted;
    $("[data-count-wrap]").hidden = !counted;
    if (counted) set("[data-count-label]", counted);
    const text = generate(type, { seed: `${seed}-${type}-${run}`, count: counted ? Number(countSel.value) : undefined, company: co });
    out.textContent = text;
    const r = analyze(text);
    set("[data-slop]", `${r.score}/100 · ${r.grade.label}`);
  }

  types.forEach((btn) =>
    btn.addEventListener("click", () => {
      types.forEach((b) => b.setAttribute("aria-checked", String(b === btn)));
      type = btn.dataset.type!;
      if (btn.dataset.count) countSel.value = btn.dataset.count;
      renderText();
    }),
  );
  countSel.addEventListener("change", renderText);
  $("[data-regen]").addEventListener("click", () => { run++; renderText(); });

  $("[data-new-co]").addEventListener("click", () => {
    seed = randomSeed();
    co = company({ seed });
    run = 0;
    history.replaceState(null, "", `?co=${seed}`);
    renderCompany();
    renderText();
  });

  const flash = (btn: HTMLElement, msg: string) => {
    const old = btn.textContent;
    btn.textContent = msg;
    setTimeout(() => (btn.textContent = old), 2000);
  };
  const copy = async (btn: HTMLElement, text: string) => {
    try { await navigator.clipboard.writeText(text); flash(btn, "Copied ✓"); }
    catch { flash(btn, "Copy failed"); }
  };
  $("[data-share]").addEventListener("click", (e) => copy(e.currentTarget as HTMLElement, `${location.origin}${location.pathname}?co=${seed}`));
  $("[data-copy-out]").addEventListener("click", (e) => copy(e.currentTarget as HTMLElement, out.textContent || ""));
  document.querySelectorAll<HTMLElement>("[data-copy-text]").forEach((b) => b.addEventListener("click", () => copy(b, b.dataset.copyText || "")));
  $("[data-logo-dl]").addEventListener("click", () => {
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([logoSvg(co)], { type: "image/svg+xml" }));
    a.download = `${co.shortName.toLowerCase()}-logo.svg`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  });

  renderCompany();
  renderText();
</script>
